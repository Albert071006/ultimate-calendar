{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "ultimate-calendar-busy"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Shanghai"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cloud"
            },
            "dataInstanceId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "generation": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "dataInstanceId",
            "generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "dataInstanceId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "kind",
            "dataInstanceId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fromDate": {
      "type": "string"
    },
    "toDate": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "busyIntervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "course",
              "work",
              "event"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "version",
    "timezone",
    "source",
    "fromDate",
    "toDate",
    "exportedAt",
    "request",
    "instructions",
    "busyIntervals",
    "coverage"
  ],
  "additionalProperties": false,
  "title": "Ultimate Calendar calendar-busy-v1",
  "description": "See ../plan-file-format.md. Runtime also validates real dates, references, interval order, source identity, planning-state fingerprints and current calendar conflicts. Context files are read-only planning handoffs, never import requests."
}
